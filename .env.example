# ==============================================================================
# ArenaMind AI - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# App Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_VERSION=1.0.0-dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database Configuration (Supabase + Prisma)
# ------------------------------------------------------------------------------
# Transactional connection pooler string (Port 6543)
DATABASE_URL="postgres://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection string for migrations (Port 5432)
DIRECT_URL="postgres://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Find these in your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only keys (DO NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# Google Gemini SDK Configuration
# ------------------------------------------------------------------------------
# Find this in your Google AI Studio API Keys
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# Security & Auth
# ------------------------------------------------------------------------------
# A random 32-byte string for signing session cookies if needed
# Not required by Supabase Auth, but good practice for other crypto needs
SESSION_SECRET=generate-a-secure-random-string-here

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://staging.arenamind.ai

GROK_API_KEY="xai-placeholder"
