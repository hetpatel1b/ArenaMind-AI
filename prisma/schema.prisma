generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, pgcrypto, uuid_ossp(map: "uuid-ossp")]
}

// ==========================================
// NextAuth Core Tables
// ==========================================

model Account {
  id                String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  deviceInfo   String?  @map("device_info")
  ipAddress    String?  @map("ip_address")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==========================================
// Enterprise Core
// ==========================================

model Organization {
  id           String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String  @unique
  logo         String?
  timezone     String  @default("UTC")
  country      String
  region       String?
  subscription String  @default("enterprise")
  status       String  @default("active")
  createdById  String? @map("created_by_id") @db.Uuid
  settings     Json    @default("{}") // Branding, Modules Enabled, Limits

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  users     User[]
  matches   Match[]
  venues    Venue[]
  auditLogs AuditLog[]
  reports   Report[]

  // Phase 17 Sprint 2 additions
  roles             Role[]
  permissions       Permission[]
  mobilitySnapshots MobilitySnapshot[]
  cameras           Camera[]
  cameraEvents      CameraEvent[]
  workforceUnits    WorkforceUnit[]
  deployments       Deployment[]
  reportFiles       ReportFile[]
  systemMetrics     SystemMetric[]
  infraNodes        InfrastructureNode[]
  infraMetrics      InfrastructureMetric[]
  devices           Device[]
  apiKeys           ApiKey[]
  backups           Backup[]
  policies          Policy[]
  certificates      Certificate[]
  storageBuckets    StorageBucket[]
  aiProviderConfigs AiProviderConfig[]
  aiPrompts         AiPrompt[]
  aiConversations   AiConversation[]
  aiGatewayLogs     AiGatewayLog[]

  @@index([deletedAt])
  @@map("organizations")
}

model User {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  name           String?
  email          String?   @unique
  emailVerified  DateTime? @map("email_verified")
  image          String?
  password       String? // bcrypt hashed
  role           UserRole  @default(read_only_analyst)
  department     String?
  phoneNumber    String?   @map("phone_number")
  employeeId     String?   @unique @map("employee_id")

  isActive     Boolean   @default(true) @map("is_active")
  isSuspended  Boolean   @default(false) @map("is_suspended")
  mfaReady     Boolean   @default(false) @map("mfa_ready")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  sessionCount Int       @default(0) @map("session_count")
  deviceCount  Int       @default(0) @map("device_count")

  preferences Json @default("{}")
  metadata    Json @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  accounts Account[]
  sessions Session[]

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  activityLogs           ActivityLog[]
  auditLogs              AuditLog[]
  aiFeedback             AiFeedback[]
  aiRecommendationsActed AiRecommendation[] @relation("ActedBy")
  incidentActions        IncidentAction[]
  assignedIncidents      Incident[]         @relation("AssignedTo")
  reportedIncidents      Incident[]         @relation("ReportedBy")
  resolvedIncidents      Incident[]         @relation("ResolvedBy")
  notifications          Notification[]
  phaseTransitions       PhaseTransition[]
  reports                Report[]
  devices                Device[]
  aiConversations        AiConversation[]
  aiGatewayLogs          AiGatewayLog[]

  @@index([organizationId])
  @@index([organizationId, role])
  @@index([organizationId, deletedAt])
  @@map("users")
}

model Venue {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @unique
  shortName      String    @map("short_name")
  city           String
  country        String    @default("Qatar")
  capacity       Int
  latitude       Decimal?  @db.Decimal(9, 6)
  longitude      Decimal?  @db.Decimal(9, 6)
  timezone       String    @default("Asia/Riyadh")
  zoneCount      Int       @default(0) @map("zone_count")
  surfaceAreaSqm Int?      @map("surface_area_sqm")
  metadata       Json      @default("{}")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matches      Match[]
  zones        Zone[]

  aiRecommendations AiRecommendation[]
  alertThresholds   AlertThreshold[]
  crowdSnapshots    CrowdSnapshot[]
  featureFlags      FeatureFlag[]
  healthScores      HealthScore[]
  kpiSnapshots      KpiSnapshot[]
  reports           Report[]
  resources         Resource[]
  systemSettings    SystemSetting[]
  mobilitySnapshots MobilitySnapshot[]
  cameras           Camera[]
  workforceUnits    WorkforceUnit[]
  infraNodes        InfrastructureNode[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("venues")
}

model Zone {
  id                String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  venueId           String                 @map("venue_id") @db.Uuid
  name              String
  shortCode         String                 @map("short_code")
  capacity          Int
  safeCapacity      Int                    @map("safe_capacity")
  isActive          Boolean                @default(true) @map("is_active")
  metadata          Json                   @default("{}")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?              @map("deleted_at") @db.Timestamptz(6)
  accessibilityReqs AccessibilityRequest[]
  crowdSnapshots    CrowdSnapshot[]
  incidents         Incident[]
  resources         Resource[]
  venue             Venue                  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  cameras           Camera[]
  deployments       Deployment[]

  @@index([venueId])
  @@index([venueId, deletedAt])
  @@map("zones")
}

model Match {
  id                 String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId     String      @map("organization_id") @db.Uuid
  venueId            String      @map("venue_id") @db.Uuid
  matchNumber        Int         @map("match_number")
  homeTeam           String      @map("home_team")
  awayTeam           String      @map("away_team")
  scheduledAt        DateTime    @map("scheduled_at") @db.Timestamptz(6)
  kickoffAt          DateTime?   @map("kickoff_at") @db.Timestamptz(6)
  endedAt            DateTime?   @map("ended_at") @db.Timestamptz(6)
  currentPhase       MatchPhase  @default(planning) @map("current_phase")
  matchStatus        MatchStatus @default(scheduled) @map("match_status")
  expectedAttendance Int?        @map("expected_attendance")
  actualAttendance   Int?        @map("actual_attendance")
  weatherSummary     String?     @map("weather_summary")
  riskLevel          String?     @map("risk_level")
  securityLevel      String?     @map("security_level")
  aiStatus           String?     @map("ai_status")
  matchConfiguration Json        @default("{}") @map("match_configuration")
  notes              String?
  metadata           Json        @default("{}")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue        Venue        @relation(fields: [venueId], references: [id])

  accessibilityRequests AccessibilityRequest[]
  aiCallLogs            AiCallLog[]
  aiRecommendations     AiRecommendation[]
  crowdSnapshots        CrowdSnapshot[]
  healthScores          HealthScore[]
  incidents             Incident[]
  kpiSnapshots          KpiSnapshot[]
  phaseTransitions      PhaseTransition[]
  queueData             QueueData[]
  reports               Report[]
  resources             Resource[]
  weatherData           WeatherData[]
  mobilitySnapshots     MobilitySnapshot[]
  cameraEvents          CameraEvent[]
  deployments           Deployment[]
  aiConversations       AiConversation[]
  aiGatewayLogs         AiGatewayLog[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([venueId])
  @@index([matchStatus])
  @@index([scheduledAt(sort: Desc)])
  @@map("matches")
}

// ==========================================
// Additional Entities
// ==========================================

model IncidentType {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String
  description String?
  defaultTier Int        @map("default_tier")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  incidents   Incident[]

  @@map("incident_types")
}

model Incident {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  matchId            String               @map("match_id") @db.Uuid
  venueId            String?              @map("venue_id") @db.Uuid
  zoneId             String?              @map("zone_id") @db.Uuid
  incidentTypeId     String?              @map("incident_type_id") @db.Uuid
  reportedBy         String               @map("reported_by") @db.Uuid
  assignedTo         String?              @map("assigned_to") @db.Uuid
  title              String
  description        String
  locationDetail     String?              @map("location_detail")
  severityTier       Int                  @default(4) @map("severity_tier")
  status             IncidentStatus       @default(open)
  aiType             String?              @map("ai_type")
  aiTier             Int?                 @map("ai_tier")
  aiConfidence       Decimal?             @map("ai_confidence") @db.Decimal(4, 3)
  aiClassificationAt DateTime?            @map("ai_classification_at") @db.Timestamptz(6)
  humanOverrideType  String?              @map("human_override_type")
  resolvedAt         DateTime?            @map("resolved_at") @db.Timestamptz(6)
  resolvedBy         String?              @map("resolved_by") @db.Uuid
  resolutionNotes    String?              @map("resolution_notes")
  tags               String[]             @default([])
  metadata           Json                 @default("{}")
  deletedAt          DateTime?            @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  aiRecommendations  AiRecommendation[]
  actions            IncidentAction[]
  attachments        IncidentAttachment[]
  assignee           User?                @relation("AssignedTo", fields: [assignedTo], references: [id])
  incidentType       IncidentType?        @relation(fields: [incidentTypeId], references: [id])
  match              Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reporter           User                 @relation("ReportedBy", fields: [reportedBy], references: [id])
  resolvedByUser     User?                @relation("ResolvedBy", fields: [resolvedBy], references: [id])
  zone               Zone?                @relation(fields: [zoneId], references: [id])

  @@index([matchId])
  @@index([matchId, deletedAt])
  @@index([matchId, status])
  @@index([matchId, severityTier])
  @@map("incidents")
}

model AiRecommendation {
  id                     String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  matchId                String       @map("match_id") @db.Uuid
  venueId                String?      @map("venue_id") @db.Uuid
  incidentId             String?      @map("incident_id") @db.Uuid
  featureName            String       @map("feature_name")
  modelName              String       @map("model_name")
  promptVersion          String       @map("prompt_version")
  data                   Json
  confidenceScore        Decimal?     @map("confidence_score") @db.Decimal(4, 3)
  hallucinationDetected  Boolean      @default(false) @map("hallucination_detected")
  outputValidationPassed Boolean      @default(true) @map("output_validation_passed")
  actionTaken            ActionTaken? @map("action_taken")
  actedBy                String?      @map("acted_by") @db.Uuid
  actedAt                DateTime?    @map("acted_at") @db.Timestamptz(6)
  dismissReason          String?      @map("dismiss_reason")
  feedbackRating         Int?         @map("feedback_rating")
  expiresAt              DateTime     @map("expires_at") @db.Timestamptz(6)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?    @map("deleted_at") @db.Timestamptz(6)
  feedback               AiFeedback[]
  actedByUser            User?        @relation("ActedBy", fields: [actedBy], references: [id])
  incident               Incident?    @relation(fields: [incidentId], references: [id])
  match                  Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  venue                  Venue?       @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([matchId, featureName])
  @@index([matchId, actionTaken])
  @@map("ai_recommendations")
}

model ResourceType {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String
  description String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  resources   Resource[]

  @@map("resource_types")
}

model Resource {
  id             String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  venueId        String?        @map("venue_id") @db.Uuid
  matchId        String?        @map("match_id") @db.Uuid
  zoneId         String?        @map("zone_id") @db.Uuid
  resourceTypeId String         @map("resource_type_id") @db.Uuid
  name           String
  status         ResourceStatus @default(available)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  match          Match?         @relation(fields: [matchId], references: [id])
  resourceType   ResourceType   @relation(fields: [resourceTypeId], references: [id])
  venue          Venue?         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  zone           Zone?          @relation(fields: [zoneId], references: [id])

  @@index([matchId, zoneId, resourceTypeId])
  @@index([matchId, status, zoneId, resourceTypeId])
  @@map("resources")
}

model CrowdSnapshot {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  matchId      String    @map("match_id") @db.Uuid
  venueId      String?   @map("venue_id") @db.Uuid
  zoneId       String    @map("zone_id") @db.Uuid
  fanCount     Int       @map("fan_count")
  safeCapacity Int       @map("safe_capacity")
  densityPct   Decimal   @map("density_pct") @db.Decimal(5, 2)
  ingressRate  Int?      @map("ingress_rate")
  egressRate   Int?      @map("egress_rate")
  recordedAt   DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  match        Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  venue        Venue?    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  zone         Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([matchId, zoneId, recordedAt(sort: Desc)])
  @@map("crowd_snapshots")
}

model KpiSnapshot {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  matchId            String    @map("match_id") @db.Uuid
  venueId            String?   @map("venue_id") @db.Uuid
  phase              String
  openIncidents      Int       @default(0) @map("open_incidents")
  tier1Incidents     Int       @default(0) @map("tier1_incidents")
  resolvedIncidents  Int       @default(0) @map("resolved_incidents")
  avgCrowdDensityPct Decimal   @map("avg_crowd_density_pct") @db.Decimal(5, 2)
  zonesAboveAlert    Int       @default(0) @map("zones_above_alert")
  resourcesDeployed  Int       @default(0) @map("resources_deployed")
  resourcesAvailable Int       @default(0) @map("resources_available")
  healthScore        Int       @default(100) @map("health_score")
  capturedAt         DateTime  @default(now()) @map("captured_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  match              Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  venue              Venue?    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([matchId, capturedAt(sort: Desc)])
  @@map("kpi_snapshots")
}

model HealthScore {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  matchId       String    @map("match_id") @db.Uuid
  venueId       String?   @map("venue_id") @db.Uuid
  score         Int
  incidentScore Int       @map("incident_score")
  crowdScore    Int       @map("crowd_score")
  resourceScore Int       @map("resource_score")
  capturedAt    DateTime  @default(now()) @map("captured_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  venue         Venue?    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([matchId, capturedAt(sort: Desc)])
  @@map("health_scores")
}

model PhaseTransition {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  matchId     String    @map("match_id") @db.Uuid
  fromPhase   String    @map("from_phase")
  toPhase     String    @map("to_phase")
  initiatedBy String    @map("initiated_by") @db.Uuid
  timestamp   DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  user        User      @relation(fields: [initiatedBy], references: [id])
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@map("phase_transitions")
}

model AccessibilityRequest {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  matchId     String    @map("match_id") @db.Uuid
  zoneId      String?   @map("zone_id") @db.Uuid
  requestType String    @map("request_type")
  status      String    @default("pending")
  priority    String    @default("medium")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  zone        Zone?     @relation(fields: [zoneId], references: [id])

  @@map("accessibility_requests")
}

model WeatherData {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  matchId          String    @map("match_id") @db.Uuid
  temperatureC     Decimal   @map("temperature_c") @db.Decimal(4, 1)
  feelsLikeC       Decimal   @map("feels_like_c") @db.Decimal(4, 1)
  weatherCondition String    @map("weather_condition")
  recordedAt       DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  match            Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("weather_data")
}

model AiCallLog {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  matchId               String?   @map("match_id") @db.Uuid
  featureName           String    @map("feature_name")
  modelName             String    @map("model_name")
  promptVersion         String    @map("prompt_version")
  success               Boolean
  latencyMs             Int       @map("latency_ms")
  promptTokens          Int?      @map("prompt_tokens")
  outputTokens          Int?      @map("output_tokens")
  hallucinationDetected Boolean   @default(false) @map("hallucination_detected")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)
  match                 Match?    @relation(fields: [matchId], references: [id])

  @@index([featureName, latencyMs(sort: Desc), createdAt(sort: Desc)])
  @@map("ai_call_logs")
}

model JobQueue {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  priority      Int       @default(0)
  runAt         DateTime  @map("run_at") @db.Timestamptz(6)
  status        JobStatus @default(pending)
  lockedBy      String?   @map("locked_by") @db.Uuid
  lockedAt      DateTime? @map("locked_at") @db.Timestamptz(6)
  lockExpiresAt DateTime? @map("lock_expires_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([priority(sort: Desc), runAt])
  @@map("job_queue")
}

model Report {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  venueId        String?       @map("venue_id") @db.Uuid
  matchId        String?       @map("match_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  type           String
  generatedAt    DateTime      @default(now()) @map("generated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  match          Match?        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  venue          Venue?        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id])
  files          ReportFile[]

  @@map("reports")
}

model SystemSetting {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  venueId   String?   @map("venue_id") @db.Uuid
  key       String
  value     Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
